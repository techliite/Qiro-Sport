# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/qirosport"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET="change-me-64-char-random-hex-string"
JWT_REFRESH_SECRET="change-me-different-64-char-random-hex"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Paystack ──────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="whsec_xxxxxxxx"

# ── Termii (SMS OTP) ──────────────────────────────────────────
TERMII_API_KEY="TLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TERMII_SENDER_ID="QiroSport"
# "true" = write OTP codes to the server log instead of sending SMS (testing only — never with real users)
OTP_LOG_ONLY="false"

# ── TheOddsAPI ────────────────────────────────────────────────
ODDS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── App ───────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ── Admin ─────────────────────────────────────────────────────
# Comma-separated. Empty = all admin access blocked in production (allowed in development)
ADMIN_IP_WHITELIST="127.0.0.1,::1"
# Separate from player JWT secrets. Generate with: openssl rand -hex 64
ADMIN_JWT_SECRET="change-me-another-64-char-random-hex"
# Proxy hops in front of the API so req.ip is the real client (Cloudflare → Railway = 2). Unset locally.
TRUST_PROXY=""
