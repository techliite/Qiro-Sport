# API calls go to /api/v1 on this app and are proxied to the API (next.config.ts rewrites).
# Leave NEXT_PUBLIC_API_URL empty to use the proxy — required in production for login cookies.
NEXT_PUBLIC_API_URL=
# Where the proxy forwards to (server-side, read at build time)
API_PROXY_TARGET=http://localhost:4000
# WebSockets can't go through the proxy — point straight at the API host
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
